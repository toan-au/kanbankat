generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stage-1 placeholder: proves the migration pipeline (container -> migrate
// -> generated client -> query) works end to end. Replaced by the real
// domain schema in Stage 2 (see docs/nestjs-migration-spec.md).
model StageOneCheck {
  id Int @id @default(autoincrement())
}
